# Kwanso Partner Portal — copy to `.env.local` for development

# API origin including /api/v1 prefix (matches admin NUXT_PUBLIC_API_BASE_URL)
VITE_API_BASE_URL=http://localhost:8787/api/v1

# Supabase project (publishable anon key is safe in the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
